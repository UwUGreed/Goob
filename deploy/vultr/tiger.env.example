# Server-only; copy to /etc/tiger/tiger.env, mode 0640 root:tiger.
# URL-encode password punctuation. Use a password different from staging login.
DATABASE_URL=postgresql://USER:PASSWORD@TIGER_CLOUD_HOST:PORT/tsdb?sslmode=verify-full&sslrootcert=/etc/tiger/tiger-ca.pem
GOOB_DATABASE_URL=postgresql://USER:PASSWORD@TIGER_CLOUD_HOST:PORT/tsdb?sslmode=verify-full&sslrootcert=/etc/tiger/tiger-ca.pem
# Explicit migration target; must match BOTH URLs including port.
TIGER_DB_HOST=TIGER_CLOUD_HOST
TIGER_DB_PORT=PORT
TIGER_DB_NAME=tsdb
GOOB_DEMO_PORT=8081
GOOB_ENV=production
# Optional separate authenticated v1 service, NOT required by current website:
# OIDC_ISSUER=https://your-real-issuer/
# OIDC_AUDIENCE=your-api-audience
# OIDC_JWKS_URL=https://your-real-issuer/.well-known/jwks.json
# ALLOWED_ORIGINS=https://your-real-domain
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_HOURLY_REQUEST_LIMIT=30
# Set after HTTPS: exact origin, no trailing slash. Leave absent for SSH tunnel.
# GOOB_PUBLIC_ORIGIN=https://your-real-domain
