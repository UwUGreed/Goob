# Local Vite middleware reads these at runtime. Never commit .env.local.
# Browser-visible; restrict to your exact website referrers + Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=your_restricted_browser_key
GOOGLE_MAP_ID=your_javascript_vector_map_id
# Server-only; enable Routes API and restrict this separate key to that API.
# A no-billing Maps Demo Key also supports Compute Routes for prototyping.
GOOGLE_MAPS_SERVER_KEY=your_server_routes_key
# Server-only; use an ElevenLabs key scoped for Scribe and token creation.
ELEVENLABS_API_KEY=your_server_elevenlabs_key
