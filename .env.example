# Server-only Tiger Cloud PostgreSQL URL. Never use a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Standalone database foundation tools; separate from application DATABASE_URL.
# No default write target. Never point mutation commands at an unknown/shared DB.
GOOB_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/goob_dev_NAME?sslmode=require
GOOB_DB_ENV=development
GOOB_DB_EXPECTED_DATABASE=goob_dev_NAME
# For verify-full, add sslrootcert=system (libpq >=16) or a trusted CA file to the URL.

# Vultr app server with Tiger Cloud PostgreSQL: see deploy/vultr/tiger.env.example.
# Website origin after HTTPS is enabled, e.g. https://your-real-domain (no trailing slash).
# GOOB_PUBLIC_ORIGIN=
# Website bind port; always loopback.
GOOB_DEMO_PORT=8081
# Authenticated v1 production settings are documented in
# deploy/backend/environment.example; v1 is separate from the website.
